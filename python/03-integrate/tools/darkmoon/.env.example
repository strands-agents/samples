# Base URL of your self-hosted Darkmoon Pro instance (Dashboard API)
DARKMOON_BASE_URL=https://darkmoon.example.internal

# Authenticate with either a pre-issued token...
DARKMOON_TOKEN=
# ...or dashboard credentials
DARKMOON_USERNAME=
DARKMOON_PASSWORD=

# Hosts the `scan` command may ever launch against (comma separated, *.wildcards allowed)
DARKMOON_ALLOWED_TARGETS=staging.example.com,*.qa.example.com

# AWS Region for Bedrock (optional, defaults to us-west-2)
AWS_REGION=us-west-2
