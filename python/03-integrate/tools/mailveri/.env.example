# MailVeri API key: https://app.mailveri.com/api-keys/
MAILVERI_API_KEY=your-mailveri-api-key

# Amazon Bedrock model (uses your AWS credentials and region)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Used in the drafted emails
SENDER_NAME=Sam
SENDER_COMPANY=Example Co

# Hold ROLE_ACCOUNT and CATCH_ALL addresses for review unless set to true
SEND_ROLE_ACCOUNTS=false
SEND_CATCH_ALL=false
