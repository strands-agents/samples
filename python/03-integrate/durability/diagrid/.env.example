# Which model provider the agent uses: "bedrock" (default) or "openai".
MODEL_PROVIDER=bedrock

# Amazon Bedrock (used when MODEL_PROVIDER=bedrock).
# Credentials come from the default AWS credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# OpenAI (used when MODEL_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# Uncomment to turn off the anonymous usage event the diagrid package sends.
# DO_NOT_TRACK=1
