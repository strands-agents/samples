# ==============================================================
# Exa Deep Research Assistant Configuration with Observability
# ==============================================================
# Copy this file to .env and fill in your API key

# ============================================
# REQUIRED: Exa API Configuration
# ============================================
# Get your API key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=ADD_YOUR_EXA_API_KEY_HERE

# ============================================
# OPTIONAL: AWS Configuration
# ============================================
# AWS Region for Bedrock (defaults to us-west-2 if not set)
AWS_REGION=us-west-2

# ============================================
# OPTIONAL: AWS CloudWatch Observability
# ============================================
# These variables enable tracing and monitoring in CloudWatch
# Set AGENT_OBSERVABILITY_ENABLED=false to disable observability

# Enable/Disable observability (set to false to turn off)
AGENT_OBSERVABILITY_ENABLED=true

# OpenTelemetry Configuration for AWS
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp

# CloudWatch Log Configuration
# These will be automatically created by setup-observability.py you can also use a log group and stream of your choice
OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-aws-log-group=agents/exa-deep-research-logs,x-aws-log-stream=default,x-aws-metric-namespace=bedrock-agentcore

# Service Identification
OTEL_RESOURCE_ATTRIBUTES=service.name=exa-deep-research

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file to .env:
#    cp .env-obs.example .env
#
# 2. Add your Exa API key to the .env file
#
# 3. For observability (optional):
#    a. Run: python setup-observability.py
#    b. This will create CloudWatch log groups
#    c. Run your app with: opentelemetry-instrument python deep_research_assistant.py "your query here"
#
# 4. To disable observability:
#    Set AGENT_OBSERVABILITY_ENABLED=false