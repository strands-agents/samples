# ---- Server ----
# Port the Express server listens on
PORT=3000

# ---- Model provider (Amazon Bedrock) ----
# AWS region used by the Bedrock model
AWS_REGION=us-east-1
# Bedrock model id used by the chatbot agent
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# AWS credentials are read from the default AWS credential chain
# (environment, shared config/credentials file, SSO, IAM role, etc.).
# Uncomment to set them explicitly for local development:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- MCP (optional) ----
# Streamable HTTP URL of an MCP server whose tools are loaded at startup.
# Default: the public, no-auth AWS Knowledge MCP Server (up-to-date AWS docs,
# code samples, and official content). See:
# https://docs.aws.amazon.com/... (search "AWS Knowledge MCP Server")
# Leave empty to run without MCP tools.
MCP_SERVER_URL=https://knowledge-mcp.global.api.aws

# ---- Rate limiting (RateLimitIntervention) ----
# Max tool calls allowed per session within the window
RATE_LIMIT_MAX_TOOL_CALLS=10
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# ---- Moderation (ModerationIntervention) ----
# Comma-separated list of blocked terms (case-insensitive). Leave empty to disable.
MODERATION_BLOCKED_TERMS=
