# ---------------------------------------------------------------------------
# Model provider — the Vercel AI SDK owns the provider; Strands wraps it.
# ---------------------------------------------------------------------------
# Which provider to use: "bedrock" (default) or "openai".
MODEL_PROVIDER=bedrock

# --- Amazon Bedrock (default) ---
# Uses the standard AWS credential chain. On Vercel, set these as env vars.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional session token if using temporary credentials.
# AWS_SESSION_TOKEN=
# Override the default Bedrock model id if desired.
# Amazon Nova Pro (free-tier friendly) via cross-region inference profile.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- OpenAI (optional; set MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# ---------------------------------------------------------------------------
# Sessions — Strands persists conversation state via pluggable storage.
# ---------------------------------------------------------------------------
# "memory" (default), "file", or "s3".
SESSION_BACKEND=memory

# --- file backend ---
SESSION_DIR=./.sessions

# --- s3 backend (recommended for serverless / AgentCore container path) ---
SESSION_S3_BUCKET=
SESSION_S3_PREFIX=sessions/
